---
layout: base.njk
---
{%- set o = site.opening -%}
{%- set loc = site.location -%}
{%- set c = site.contact -%}
{%- set hoursText = (o.opens | time12) + "–" + (o.closes | time12) -%}
{%- set directions = "https://www.google.com/maps/dir/?api=1&destination=" + (loc.mapsQuery | urlencode) -%}
{%- set insta = "https://www.instagram.com/" + (c.instagram | handle) + "/" -%}

<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <a class="nav__mark" href="#top" aria-label="Local Roots, back to top"><span class="logo" aria-hidden="true"></span><span class="nav__name">Local <span>Roots</span></span></a>
  <nav aria-label="Sections">
    <a class="ulink" href="#prices">Prices</a>
    <a class="ulink" href="#farms">Farms</a>
    <a class="ulink" href="#help">Get involved</a>
    <a class="ulink" href="#visit">Visit</a>
  </nav>
  <button class="btn btn--small btn--ghost" type="button" data-share>Share</button>
</header>

<main id="main">

  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__text">
      {#- one-off stall news, e.g. a missed week; it takes itself down after its "until" day -#}
      {% if o.notice and not (o.noticeUntil | isPast) %}
      <p class="notice" role="note"{% if o.noticeUntil %} data-until="{{ o.noticeUntil }}"{% endif %}><svg class="notice__icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="M8 4v5" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.8" r="1.05"/></svg>{{ o.notice }}</p>
      {% endif %}
      {% if site.badge %}<p class="hero__eyebrow">{{ site.badge }}</p>{% endif %}
      <h1 class="hero__promise" id="hero-title">{{ site.tagline }}</h1>
      <p class="hero__intro">{{ site.intro }}</p>

      <!-- one callout: when and where to find the stall -->
      <div class="hero__stall when">
        <p class="when__time">{{ o.day }}s<br> {{ hoursText }}</p>
        <p class="when__where">{{ loc.venue }}, {{ loc.address }}</p>
        <p class="status" data-status
           data-day="{{ o.day }}" data-opens="{{ o.opens }}" data-closes="{{ o.closes }}"
           aria-live="polite"></p>
        <div class="when__actions">
          <a class="btn" href="{{ directions }}" target="_blank" rel="noopener">Get directions</a>
          <a class="ulink when__cal" href="/local-roots.ics">Add to calendar</a>
        </div>
      </div>

      <!-- the chard stands beside the card, the card laid over its edge -->
      <figure class="frame frame--arch hero__photo">
        <img src="{{ site.heroPhoto }}" alt="{{ site.heroPhotoAlt }}"
             sizes="(min-width: 760px) 13rem, 1px" loading="eager" fetchpriority="high">
      </figure>
    </div>

    <!-- hand-drawn Oxford, with the pin on the cafe -->
    <div class="hero__plate">
      {% include "map.svg" %}
    </div>
    <script>
      // Frame the map to its box: on phones zoom in around the pin; everywhere, set the scale bar in the
      // bottom-right corner of what's showing, with the north arrow above it. Inline so the map never jumps.
      (() => {
        const map = document.querySelector(".hero__plate .map");
        const W = 1200, H = 800, PIN = [540, 380], ZOOM = 1.5;
        const scaleBar = map.querySelector(".map__scale"), compass = map.querySelector(".map__compass");
        const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);
        // the compass and scale sit inside a shifted group, so add up the shifts above them
        const offset = (el) => {
          let x = 0, y = 0;
          for (let n = el.parentNode; n !== map; n = n.parentNode) {
            const t = n.transform && n.transform.baseVal.consolidate();
            if (t) { x += t.matrix.e; y += t.matrix.f; }
          }
          return [x, y];
        };
        // move el so its bottom-right corner lands on (right, bottom), in map units
        const place = (el, right, bottom) => {
          const b = el.getBBox(), [ox, oy] = offset(el);
          el.setAttribute("transform", `translate(${right - ox - b.x - b.width} ${bottom - oy - b.y - b.height})`);
          return bottom - b.height;
        };
        const fit = () => {
          const r = map.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const aspect = r.width / r.height;
          let w = Math.min(W, H * aspect), h = w / aspect, x, y;
          if (matchMedia("(max-width: 759px)").matches) {
            w /= ZOOM; h /= ZOOM;
            // the pin sits a little left of centre so its name fits beside it, and a touch below the middle,
            // since the top of the map fades under the words
            x = clamp(PIN[0] - w * .47, 0, W - w); y = clamp(PIN[1] - h * .45, 0, H - h);
          } else {
            // nudged left of centre so more of the river shows
            x = clamp((W - w) / 2 - 30, 0, W - w); y = (H - h) / 2;
          }
          map.setAttribute("viewBox", `${x} ${y} ${w} ${h}`);
          const m = 20 * w / r.width;   // 20px in map units
          const top = place(scaleBar, x + w - m, y + h - m);
          place(compass, x + w - m - 8 * w / r.width, top - m * .6);
        };
        fit();
        new ResizeObserver(fit).observe(map);
      })();
    </script>
  </section>

  <section class="fair" id="prices" aria-labelledby="prices-title">
    <div class="wrap fair__grid">
      <div class="fair__prices">
        <h2 id="prices-title">Pick your price</h2>
        <p class="lede">Many items come in three prices. Pick the one that fits your week. No one checks.</p>
        <div class="menu">
          <p class="menu__item">{{ site.exampleItem }}</p>
          <ol class="menu__rows" role="list">
            {% for t in site.tiers %}
            <li>
              <div class="menu__line">
                <h3>{{ t.name }}</h3>
                <span class="menu__dots" aria-hidden="true"></span>
                <span class="menu__price">{{ t.example }}</span>
              </div>
              <p>{{ t.description }}</p>
            </li>
            {% endfor %}
          </ol>
        </div>
      </div>

      <div class="fair__farms" id="farms">
        <h2 id="farms-title">Where it comes from</h2>
        <!-- one band per farm: its photo behind, the name on top -->
        <ul class="farms" role="list">
          {% for s in site.suppliers %}
          <li class="farm{% if not s.photo %} farm--plain{% endif %}">
            {#- the photo sits under a dark wash behind the name, so the small size is plenty -#}
            {% if s.photo %}<img src="{{ s.photo }}" alt="" eleventy:widths="450">{% endif %}
            <p class="farm__name">{% if s.website %}<a href="{{ s.website }}" target="_blank" rel="noopener">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</p>
            <p class="farm__grows">{{ s.grows }}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section class="stall" aria-labelledby="stall-title">
    <div class="wrap stall__head">
      <h2 id="stall-title">In season</h2>
      <p>Not sure what to do with something? Tap it for an idea.</p>
    </div>
    <div class="strip">
      <ul class="strip__track">
        {%- for n in [1, 2] %}
        {%- for p in produce.items %}
        <li class="bubble-{{ loop.index0 % 4 }}{% if loop.index0 % 2 %} low{% endif %}"{% if n == 2 %} aria-hidden="true"{% endif %}>
          {%- if p.meal %}
          <button type="button" data-recipe="{{ loop.index0 }}" aria-haspopup="dialog" aria-label="{{ p.label }}: recipe idea"{% if n == 2 %} tabindex="-1"{% endif %}>
            <span class="strip__pic">
              <img src="{{ p.photo }}" alt="" sizes="(max-width: 453px) 8.5rem, (max-width: 586px) 30vw, 11rem">
              <span class="strip__tag" aria-hidden="true">Recipe idea</span>
            </span>
            <span class="strip__name">{{ p.label }}</span>
          </button>
          {%- else %}
          <img src="{{ p.photo }}" alt="" sizes="(max-width: 453px) 8.5rem, (max-width: 586px) 30vw, 11rem">
          <span class="strip__name">{{ p.label }}</span>
          {%- endif %}
        </li>
        {%- endfor %}
        {%- endfor %}
      </ul>
    </div>
  </section>

  <!-- food miles: a supermarket's veg crosses the globe, then it zooms in until ours show. Data and distances in _data/foodmiles.js -->
  {%- set fm = foodmiles -%}
  {%- set first = fm.trips[0] -%}
  <section class="miles" id="miles" aria-labelledby="miles-title">
    <div class="wrap miles__grid">
      <div class="miles__text">
        <h2 id="miles-title">How far it travels</h2>
        <p class="lede">Pick something from the stall. See where a supermarket's usually comes from out of season, and where ours does.</p>

        <fieldset class="miles__pick">
          <legend class="vh">Pick something from the stall</legend>
          {%- for t in fm.trips %}
          <label>
            <input type="radio" name="trip" value="{{ loop.index0 }}"{% if loop.first %} checked{% endif %}>
            <span>{{ t.produce }}</span>
          </label>
          {%- endfor %}
        </fieldset>

        <dl class="miles__tally">
          <div class="miles__row miles__row--theirs" data-row="them">
            <dt>Supermarket</dt>
            <dd><span class="miles__num" data-theirs>{{ first.miles | commas }}</span> miles
              <span class="miles__how" data-theirs-how>by {{ first.by }} from {{ first.from }}</span></dd>
          </div>
          <div class="miles__row miles__row--ours" data-row="us">
            <dt>Local Roots</dt>
            <dd><span class="miles__num" data-ours>{{ first.near }}</span> <span data-ours-unit>{{ "mile" if first.near == 1 else "miles" }}</span>
              <span class="miles__how" data-ours-how>from {{ fm.farms[first.farm].name }}, as the crow flies</span>
              <ol class="miles__farms" role="list" aria-label="All our suppliers">
                {%- for f in fm.farms %}
                <li data-farm="{{ loop.index0 }}"{% if loop.index0 == first.farm %} class="is-from"{% endif %}><span class="miles__farm-num" aria-hidden="true">{{ loop.index }}</span>{{ f.name }}<span class="miles__farm-dots" aria-hidden="true"></span><span class="miles__farm-miles">{{ f.miles }} {{ "mile" if f.miles == 1 else "miles" }}</span></li>
                {%- endfor %}
              </ol></dd>
          </div>
        </dl>
        <p class="miles__times" data-times>That's about {{ first.times | commas }} times further.</p>
        <p class="miles__note">Origins are typical examples for UK supermarkets out of season. Their miles follow the usual road, sea or air route; ours are as the crow flies. Map data © <a class="ulink" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors.</p>
      </div>

      <figure class="miles__globe">
        <!-- says whose journey the globe is showing: theirs, then ours -->
        <p class="miles__caption" data-caption aria-hidden="true"><span data-caption-them>{{ first.them }}</span><span data-caption-us>{{ first.us }}</span></p>
        <svg class="globe" viewBox="0 0 640 580" role="img" aria-labelledby="globe-desc" data-globe></svg>
        <figcaption class="vh" id="globe-desc" data-globe-desc>A globe showing the route a supermarket's {{ first.produce | lower }} takes from {{ first.from }} to Oxford, {{ first.miles | commas }} miles, then zooming in on Oxford to show ours coming {{ first.near }} {{ "mile" if first.near == 1 else "miles" }} from {{ fm.farms[first.farm].name }}.</figcaption>
      </figure>
    </div>
    <script id="foodmiles" type="application/json">{{ fm | dump | safe }}</script>
    <script src="/js/vendor/d3-array.min.js" defer></script>
    <script src="/js/vendor/d3-geo.min.js" defer></script>
    <script src="/js/foodmiles.js" defer></script>
  </section>

  <section class="maryam" aria-labelledby="maryam-title">
    <div class="wrap maryam__grid">
      <figure class="frame frame--arch maryam__photo">
        <img src="{{ site.maryam.photo }}" alt="{{ site.maryam.photoAlt }}" sizes="(min-width: 900px) 360px, 75vw">
      </figure>
      <div class="maryam__text">
        <h2 id="maryam-title">{{ site.maryam.heading }}</h2>
        <p>{{ site.maryam.text }}</p>
      </div>
    </div>
  </section>

  <section class="help" id="help" aria-labelledby="help-title">
    <div class="wrap">
      <h2 id="help-title">Get involved</h2>
      <div class="help__grid">

        <div class="pitch pitch--clay">
          <h3>Chip in</h3>
          <p>A donation tops up the Supported price, so a neighbour can take home a full bag for less.</p>
          <a class="btn btn--terra" href="{{ c.donate }}" target="_blank" rel="noopener">Donate with PayPal</a>
        </div>

        <details class="pitch pitch--sage" name="involve">
          <summary>
            <h3>Volunteer</h3>
            <span class="pitch__text">Even one Sunday a month is a big help.</span>
            <span class="btn">Offer to volunteer</span>
          </summary>
          <form class="form" name="volunteer" method="POST" action="/thanks/"
                data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="volunteer">
            <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
            <label>Your name <input name="name" required autocomplete="name"></label>
            <label>Email <input type="email" name="email" required autocomplete="email"></label>
            <fieldset>
              <legend>I'd like to help with</legend>
              <label class="check"><input type="checkbox" name="help" value="Setting up and packing down"> Setting up and packing down</label>
              <label class="check"><input type="checkbox" name="help" value="Serving on the stall"> Serving on the stall</label>
              <label class="check"><input type="checkbox" name="help" value="Collecting from farms"> Collecting from farms</label>
              <label class="check"><input type="checkbox" name="help" value="Posters and social media"> Posters and social media</label>
            </fieldset>
            <label>Anything else? <textarea name="message" rows="2"></textarea></label>
            <button class="btn btn--ink" type="submit">Send offer</button>
          </form>
        </details>

        <details class="pitch pitch--bone" name="involve">
          <summary>
            <h3>Say hello</h3>
            <span class="pitch__text">An idea for the stall, a question, or something you grow?</span>
            <span class="btn">Send a message</span>
          </summary>
          <form class="form" name="contact" method="POST" action="/thanks/"
                data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact">
            <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
            <label>Your name <input name="name" required autocomplete="name"></label>
            <label>Email <input type="email" name="email" required autocomplete="email"></label>
            <label>This is about
              <select name="topic">
                <option>A suggestion</option>
                <option>A question</option>
                <option>I'm a grower or producer</option>
                <option>Something else</option>
              </select>
            </label>
            <label>Message <textarea name="message" rows="3" required></textarea></label>
            <button class="btn btn--ink" type="submit">Send message</button>
          </form>
        </details>

      </div>
    </div>
  </section>

  <section class="visit" id="visit" aria-labelledby="visit-title">
    <div class="wrap visit__grid">
      <div class="visit__text">
        <h2 id="visit-title">Come and visit</h2>
        <p class="visit__when">{{ o.day }}s, {{ hoursText }}</p>
        <address>{{ loc.venue }}<br>{{ loc.address }}{% if loc.postcode %}<br>{{ loc.postcode }}{% endif %}</address>
        {% if loc.notes %}<p class="visit__notes">{{ loc.notes }}</p>{% endif %}
        <div class="actions">
          <a class="btn btn--light" href="{{ directions }}" target="_blank" rel="noopener">Get directions</a>
          <a class="btn btn--ghost-light" href="/local-roots.ics">Add to calendar</a>
        </div>
      </div>
      {% if loc.lat and loc.lng %}
      {%- set lat = loc.lat | float -%}{%- set lng = loc.lng | float -%}
      <iframe class="visit__map" title="Map showing {{ loc.venue }}" loading="lazy"
        src="https://www.openstreetmap.org/export/embed.html?bbox={{ lng - 0.006 }}%2C{{ lat - 0.003 }}%2C{{ lng + 0.006 }}%2C{{ lat + 0.003 }}&amp;layer=mapnik&amp;marker={{ lat }}%2C{{ lng }}"></iframe>
      {% else %}
      <figure class="frame frame--arch visit__photo">
        <img src="{{ loc.photo }}" alt="{{ loc.photoAlt }}" sizes="18rem">
      </figure>
      {% endif %}
    </div>
  </section>

</main>

<footer class="footer">
  <div class="wrap footer__grid">
    <p class="footer__name">
      <span class="logo logo--footer" aria-hidden="true"></span>
      Local Roots
    </p>
    <ul class="footer__links" role="list">
      <li><a class="ulink" href="{{ insta }}" target="_blank" rel="noopener">Instagram</a></li>
      {% if c.facebook %}<li><a class="ulink" href="{{ c.facebook }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
      {% if c.whatsapp %}<li><a class="ulink" href="{{ c.whatsapp }}" target="_blank" rel="noopener">WhatsApp group</a></li>{% endif %}
      <li><a class="ulink" href="mailto:{{ c.email }}">{{ c.email }}</a></li>
      <li><a class="ulink" href="{{ c.donate }}" target="_blank" rel="noopener">Donate</a></li>
      <li><button type="button" class="ulink linkish" data-share>Share this page</button></li>
    </ul>
    <p class="footer__small">Grown nearby, sold in Cowley. © {{ "" | year }} Local Roots</p>
  </div>
</footer>

<dialog class="share" id="share-dialog" aria-labelledby="share-title">
  <form method="dialog">
    <h2 id="share-title">Share Local Roots</h2>
    {%- set shareText = site.name + ": " + site.tagline + " " + o.day + "s " + hoursText + ", " + loc.venue + ", Cowley." -%}
    <ul class="share__list" role="list">
      <li><button type="button" class="btn" data-copy="{{ site.url }}">Copy link</button></li>
      <li><a class="btn btn--ghost" target="_blank" rel="noopener" href="https://wa.me/?text={{ (shareText + ' ' + site.url) | urlencode }}">WhatsApp</a></li>
      <li><a class="btn btn--ghost" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ site.url | urlencode }}">Facebook</a></li>
      <li><a class="btn btn--ghost" target="_blank" rel="noopener" href="https://x.com/intent/post?text={{ shareText | urlencode }}&amp;url={{ site.url | urlencode }}">X</a></li>
      <li><a class="btn btn--ghost" href="mailto:?subject={{ site.name | urlencode }}&amp;body={{ (shareText + ' ' + site.url) | urlencode }}">Email</a></li>
    </ul>
    <p class="share__done" data-copied hidden role="status">Link copied</p>
    <button class="share__close" value="close" aria-label="Close">×</button>
  </form>
</dialog>

<!-- "What do I do with this?": one card, filled in from produce.json by main.js, with the photo the strip already loaded -->
<dialog class="recipe" id="recipe-dialog" aria-labelledby="recipe-title">
  <form method="dialog">
    <p class="recipe__kicker">What do I do with this?</p>
    <div class="recipe__head">
      <img class="recipe__photo" data-recipe-photo src="" alt="" width="450" height="600" eleventy:ignore>
      <h2 id="recipe-title" data-recipe-title></h2>
    </div>
    <dl class="recipe__lines">
      <dt>Try this</dt><dd data-recipe-meal></dd>
      <dt>Keeping it</dt><dd data-recipe-keep></dd>
      <dt>What you can eat</dt><dd data-recipe-eat></dd>
    </dl>
    <p class="recipe__save">
      <button type="button" class="btn btn--ghost btn--small" data-recipe-save>Save this</button>
      <span data-recipe-saved hidden role="status">Copied</span>
    </p>
    <button class="recipe__close" value="close" aria-label="Close">×</button>
  </form>
</dialog>
<script id="recipes" type="application/json">{{ produce.items | dump | safe }}</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GroceryStore",
  "name": {{ site.name | dump | safe }},
  "description": {{ site.intro | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "image": {{ (site.url + "/images/brand/og-share.jpg") | dump | safe }},
  "email": {{ c.email | dump | safe }},
  "priceRange": "£",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ (loc.venue + ", " + loc.address) | dump | safe }},
    "addressLocality": "Oxford",
    "postalCode": {{ loc.postcode | dump | safe }},
    "addressCountry": "GB"
  },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": {{ ("https://schema.org/" + o.day) | dump | safe }},
    "opens": {{ o.opens | dump | safe }},
    "closes": {{ o.closes | dump | safe }}
  }],
  "sameAs": [{{ insta | dump | safe }}]
}
</script>

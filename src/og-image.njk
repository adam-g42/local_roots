---
permalink: /og-image/
eleventyExcludeFromCollections: true
---
{#- Rendered to images/brand/og-share.jpg by `npm run og`. Not linked from the site. -#}
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/style.css">
{% include "fonts-head.njk" %}
<style>
  body { width: 1200px; height: 630px; margin: 0; display: grid; grid-template-columns: 1fr 600px; overflow: hidden; }
  body::before { display: none; }
  .og-left { padding: 70px 0 0 80px; }
  .og-left h1 { font-size: calc(112px * var(--head-scale)); line-height: 1; white-space: nowrap; margin-top: 40px; }
  .og-left h1 { display: flex; align-items: stretch; gap: 22px; line-height: .92; }
  .og-logo { height: 1.85em; align-self: stretch; }
  .og-left h1 span span { font-style: var(--accent-style); color: var(--leaf); }
  .og-left .tag { font-family: var(--accent) !important; font-style: var(--accent-style) !important; font-size: calc(40px * var(--accent-scale)) !important; }
  .og-left .tag { font: italic 500 40px/1.2 var(--serif); color: var(--terra); margin: 34px 0 30px; }
  .og-left .fact { font: 500 34px/1.25 var(--serif); margin: 0; padding: 10px 0; border-top: 1px solid var(--line); width: 560px; }
  .og-left .fact:last-child { border-bottom: 1px solid var(--line); }
  /* the hand-drawn map from the top of the page, framed on the stall's pin, on the same crumpled paper */
  .og-right { position: relative; isolation: isolate; overflow: hidden; }
  .og-right::before { content: ""; position: absolute; inset: 0; z-index: -1; background: url(/images/brand/paper.jpg) center / cover; opacity: .3; }
  .og-right .map { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* fades in from the left, so there's no hard line between the words and the map */
  .og-right .map, .og-right::before {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 140px);
            mask-image: linear-gradient(to right, transparent, #000 140px);
  }
  /* a still picture: everything drawn in at once, and no scale bar, compass or pulsing ring */
  .og-right .map * { animation-duration: 0s !important; animation-delay: 0s !important; }
  .og-right .map__scale, .og-right .map__compass, .og-right .map__pulse { display: none; }
</style>
</head>
<body>
  <div class="og-left">
    <h1><span class="logo og-logo" aria-hidden="true"></span><span>Local<br><span>Roots</span></span></h1>
    <p class="tag">{{ site.tagline }}</p>
    <p class="fact">Every {{ site.opening.day }}, {{ site.opening.opens | time12 }}–{{ site.opening.closes | time12 }}</p>
    <p class="fact">{{ site.location.venue }}, {{ site.location.address }}</p>
  </div>
  <div class="og-right">
    {#- the map is 1200 x 800; this crop matches the panel's shape, with the pin (540, 380) placed so its name fits -#}
    {% set mapSvg %}{% include "map.svg" %}{% endset %}
    {{ mapSvg | replace('viewBox="0 0 1200 800"', 'viewBox="280 80 600 630"') | safe }}
  </div>
</body>
</html>

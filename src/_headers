# Cloudflare Pages reads this file for extra response headers

/images/*
  Cache-Control: public, max-age=604800

# resized photos: the file name changes whenever the photo does, so browsers can keep them for good
/img/*
  Cache-Control: public, max-age=31536000, immutable

/local-roots.ics
  Content-Type: text/calendar; charset=utf-8

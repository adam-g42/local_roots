---
permalink: /local-roots.ics
eleventyExcludeFromCollections: true
---
{%- set o = site.opening -%}
{#- the first stall in the calendar: the "next open" day while that's still to come, otherwise the coming one -#}
{%- set start = o.nextOpen | replace("-", "") if (o.nextOpen and not (o.nextOpen | isPast)) else (o.day | nextDate) -%}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Local Roots//Sunday stall//EN
CALSCALE:GREGORIAN
BEGIN:VTIMEZONE
TZID:Europe/London
BEGIN:DAYLIGHT
TZOFFSETFROM:+0000
TZOFFSETTO:+0100
TZNAME:BST
DTSTART:19700329T010000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0100
TZOFFSETTO:+0000
TZNAME:GMT
DTSTART:19701025T020000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:weekly-stall@local-roots
DTSTAMP:{{ start }}T000000Z
DTSTART;TZID=Europe/London:{{ start }}T{{ o.opens | icsTime }}
DTEND;TZID=Europe/London:{{ start }}T{{ o.closes | icsTime }}
RRULE:FREQ=WEEKLY;BYDAY={{ o.day | byDay }}
SUMMARY:Local Roots veg stall
LOCATION:{{ (site.location.venue + ", " + site.location.address) | icsEscape | safe }}
DESCRIPTION:{{ (site.tagline + " " + site.url) | icsEscape | safe }}
URL:{{ site.url }}
END:VEVENT
END:VCALENDAR

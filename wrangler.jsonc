// Cloudflare Workers: serves the built site from _site, and runs worker/ for the form emails and the editor login.
// Cloudflare builds it with `npm run build`, then deploys it with `npx wrangler deploy`.
// The variables and secrets (see README) are set in the dashboard, not here.
{
  "name": "localrootsoxford",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // keep the variables set in the dashboard when deploying
  "keep_vars": true
}
